# Local (non-Docker) nginx for the native Penpot stack.
# Generated from scripts/native/nginx.conf.in by setup.sh; do not edit the
# generated copy. Serves the frontend and proxies API traffic to the backend,
# replicating docker/devenv/files/nginx.conf without TLS.

worker_processes 1;
pid @BASE@/nginx/nginx.pid;
error_log @BASE@/nginx/error.log warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    types_hash_max_size 4096;
    types_hash_bucket_size 128;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 100;
    server_tokens off;

    client_body_temp_path @BASE@/nginx/client_body;
    proxy_temp_path       @BASE@/nginx/proxy;
    fastcgi_temp_path     @BASE@/nginx/fastcgi;
    uwsgi_temp_path       @BASE@/nginx/uwsgi;
    scgi_temp_path        @BASE@/nginx/scgi;

    access_log @BASE@/nginx/access.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/transit+json image/svg+xml
               application/wasm;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 127.0.0.1:@PORT@;
        server_name localhost;

        client_max_body_size 300M;
        charset utf-8;

        root @REPO@/frontend/resources/public;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_buffer_size 16k;
        proxy_busy_buffers_size 24k;
        proxy_buffers 32 4k;

        etag off;
        proxy_hide_header X-Powered-By;

        location /assets {
            proxy_pass http://127.0.0.1:6060/assets;
        }

        location /internal/assets {
            internal;
            alias @REPO@/backend/assets;
        }

        location = /link-preview {
            proxy_pass http://127.0.0.1:6060/link-preview$is_args$args;
        }

        location /api/export {
            proxy_pass http://127.0.0.1:6061;
        }

        location /api/remote-relay {
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_pass http://127.0.0.1:3448;
        }

        location /api {
            proxy_pass http://127.0.0.1:6060/api;
            proxy_http_version 1.1;
        }

        location /management {
            proxy_pass http://127.0.0.1:6060/management;
            proxy_http_version 1.1;
        }

        location /webhooks {
            proxy_pass http://127.0.0.1:6060/webhooks;
        }

        location /dbg {
            proxy_pass http://127.0.0.1:6060/dbg;
        }

        location /ws/notifications {
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_pass http://127.0.0.1:6060/ws/notifications;
        }

        location /plugins {
            autoindex on;
            alias @REPO@/plugins/dist/apps;
        }

        location / {
            try_files $uri /index.html$is_args$args /index.html =404;
            add_header Cache-Control "no-store" always;
        }
    }
}
